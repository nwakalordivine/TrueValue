# Neon Postgres (copy from the Neon dashboard, keep the +asyncpg and ?ssl=require parts)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
# Redis (optional, used for caching and rate limiting)
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# OpenRouter (optional: without it the assistant runs in rule-based mode)
OPENROUTER_API_KEY=
LLM_MODEL_PRIMARY=nvidia/nemotron-3.5-lightning:free
LLM_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
# Comma separated frontend URLs allowed to call the API (add your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173
# Feedback form: emails go to FEEDBACK_EMAIL (Gmail needs an App Password in SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
FEEDBACK_EMAIL=
# Accounts: sign-in codes are emailed, so SMTP_USER and SMTP_PASSWORD above are required for sign-in.
# Generate JWT_SECRET with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without JWT_SECRET the sign-in endpoints answer 503 and the rest of the app keeps working.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
LOGIN_CODE_MINUTES=10
# Profile pictures (Cloudinary dashboard, "API environment variable"). Empty = profile pictures switched off.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Comma separated emails of signed-in users who may read the feedback list (GET /api/feedback)
ADMIN_EMAILS=
