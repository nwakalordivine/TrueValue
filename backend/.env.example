# Neon Postgres (copy from the Neon dashboard, keep the +asyncpg and ?ssl=require parts)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/neondb?ssl=require
# Redis (optional, used for caching and rate limiting)
REDIS_URL=rediss://default:PASSWORD@HOST:6379
# OpenRouter (optional: without it the assistant runs in rule-based mode)
OPENROUTER_API_KEY=
LLM_MODEL_PRIMARY=nvidia/nemotron-3.5-lightning:free
LLM_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
# Comma separated frontend URLs allowed to call the API (add your deployed frontend URL)
CORS_ORIGINS=http://localhost:5173
# Feedback form: emails go to FEEDBACK_EMAIL (Gmail needs an App Password in SMTP_PASSWORD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
FEEDBACK_EMAIL=
